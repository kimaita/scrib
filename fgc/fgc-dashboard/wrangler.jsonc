{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "fgc-dashboard",
    "compatibility_date": "2025-04-03",
    "pages_build_output_dir": ".svelte-kit/cloudflare",
    "observability": {
        "enabled": true
    },
    /**
	 * Environment Variables
	 */
    "vars": {
        "API_BASE_URL": "https://scrib-api.childrick.workers.dev",
        "PROCESSING_API_URL": "https://cloudtasks.googleapis.com/v2/projects/pristine-cairn-450503-r1/locations/europe-west1/queues/scrib-processing-queue/tasks:buffer"
    }
}